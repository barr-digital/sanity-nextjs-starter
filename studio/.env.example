# Shared across environments — copy to .env
SANITY_STUDIO_PROJECT_ID="<paste your project ID here>" # Required - The ID of your Sanity project
SANITY_STUDIO_PREVIEW_URL="" # Optional - defaults to http://localhost:3000

# Per-environment values live in COMMITTED code: npm scripts (studio/package.json)
# + fallbacks in sanity.cli.ts / sanity.config.tsx, all defaulting to development.
# Optional overrides: gitignored .env.development / .env.production (loaded per mode:
# `sanity dev`/`deploy:dev` read .env.development; `deploy:prod` reads .env.production).
# SANITY_STUDIO_DATASET="development"
# SANITY_STUDIO_STUDIO_HOST="" # e.g. "my-project" in .env.production, "my-project-dev" in .env.development
# SANITY_STUDIO_APP_ID="" # per-environment Studio appId (printed by the first deploy)
