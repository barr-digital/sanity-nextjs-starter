# Shared across environments — copy to .env
SANITY_STUDIO_PROJECT_ID="<paste your project ID here>" # Required - The ID of your Sanity project
SANITY_STUDIO_PREVIEW_URL="" # Optional - defaults to http://localhost:3000

# Per-environment — copy to .env.development and .env.production with the right values.
# `sanity dev` and `npm run deploy:dev` load .env.development; `npm run deploy:prod` loads .env.production.
# These files hold no secrets (dataset + hostname), so they can be committed in projects.
SANITY_STUDIO_DATASET="production" # "development" in .env.development
SANITY_STUDIO_STUDIO_HOST="" # e.g. "my-project" in .env.production, "my-project-dev" in .env.development
