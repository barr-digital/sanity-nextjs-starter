{
  "name": "studio",
  "version": "0.6.0",
  "private": true,
  "keywords": [
    "sanity"
  ],
  "license": "UNLICENSED",
  "main": "package.json",
  "scripts": {
    "prebuild": "npm run extract-types",
    "build": "sanity build",
    "deploy:dev": "SANITY_ACTIVE_ENV=development sanity deploy",
    "deploy:prod": "sanity deploy",
    "dev": "sanity dev",
    "extract-types": "sanity schema extract --enforce-required-fields",
    "start": "sanity start",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/document-internationalization": "^6.0.6",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/language-filter": "^5.0.1",
    "@sanity/vision": "^5.19.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "pluralize-esm": "^9.0.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rxjs": "^7.8.2",
    "sanity": "^5.19.0",
    "sanity-plugin-internationalized-array": "^5.0.0",
    "sanity-plugin-lucide-icon-picker": "^1.0.3",
    "sanity-plugin-media": "^4.1.1",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.7",
    "typescript": "^5.9.3"
  }
