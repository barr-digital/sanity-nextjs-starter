{
  "name": "sanity-nextjs-starter",
  "version": "1.2.3",
  "private": true,
  "description": "Next.js + Sanity starter template with i18n, PageBuilder, and custom components",
  "keywords": [
    "Sanity",
    "Next.js",
    "Headless CMS",
    "i18n",
    "next-intl",
    "PageBuilder",
    "Visual Editing",
    "TypeScript"
  ],
  "homepage": "https://github.com/barr-digital/sanity-nextjs-starter#readme",
  "bugs": {
    "url": "https://github.com/barr-digital/sanity-nextjs-starter/issues"
  },
  "workspaces": [
    "studio",
    "frontend"
  ],
  "overrides": {
    "@sanity/client": "8.6.1",
    "dompurify": "^3.4.17",
    "fast-uri": "^3.1.9",
    "shell-quote": "^1.11.0",
    "smol-toml@^1": "^1.9.0",
    "source-map-js": "^1.2.2",
    "undici@^7": "^7.30.1",
    "vite": "^8.3.3",
    "brace-expansion@^1": "^1.1.21",
    "brace-expansion@^5": "^5.0.12",
    "postcss-selector-parser@^6": "^6.1.5"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@swc/core": true,
    "esbuild": true,
    "unrs-resolver": true
  },
  "scripts": {
    "dev": "npm-run-all --parallel --print-label dev:*",
    "dev:next": "npm run dev --workspace=frontend",
    "dev:studio": "npm run dev --workspace=studio",
    "format": "prettier --cache --write .",
    "lint": "npm run lint --workspace=frontend",
    "type-check": "npm run type-check --workspaces",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.1"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "npm-run-all2": "^5.0.2",
    "prettier": "^3.7.3",
    "prettier-plugin-tailwindcss": "^0.6.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,mjs,cjs}": "prettier --write"
  }
}
